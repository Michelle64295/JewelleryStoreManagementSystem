@model JewelleryStoreManagementSystem.Data.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/productdetails.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
</head>
<body>

    <ul style="background-color: #9b7d61;">
        <li><a href="@Url.Action("Home", "Home")"><img src="~/images/Logo.png" alt="Logo" class="logo"></a></li>
        <li style="float:right"><a href="@Url.Action("Order", "Order")">Shopping Cart</a></li>
        <li style="float:right"><a href="@Url.Action("Products", "Products")">Products</a></li>
    </ul>

    <div class="main-container">
        <div class="product-image">
            <img src="@Url.Content(Model.ImagePath)" alt="@Model.Name" />
        </div>

        <div class="product-details">
            <ul>
                <li style="display: inline-block;"><h4>@Model.Name</h4></li>
                <li style="display: inline-block; float: right;"><h4>@Model.Price</h4></li>
            </ul>
            <p>@Model.Description</p>
            <form asp-controller="Order" asp-action="Order" method="post">
                <input type="hidden" name="productId" value="@Model.ProductId"/>
                <label for="quantity">Quantity: </label>
                <select name="quantity" id="quantity">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </select>
                <br />
                <div class="order-button">
                    <button type="submit">Add To Cart</button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>