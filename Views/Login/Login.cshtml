@{
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
</head>

<body style="background-color: #e9e3d8;">

    <div class="container">

        <div class="image">
            <img src="~/images/LoginPage.png" alt="Jewellery" class="jewellery-image" >
        </div>

        <div class="form-container">
            <input type="radio" name="tab" id="login-tab" checked>
            <input type="radio" name="tab" id="signup-tab">

            <div class="tabs">
                <label for="login-tab" class="tab-label">Login</label>
                <label for="signup-tab" class="tab-label">Sign up</label>
            </div>

            <div class="content">

                <div id="login-content" class="form">
                    <form asp-action="Login" method="post">

                        <input placeholder="Enter your email" type="email" id="email" name="email" required>
                        <input placeholder="Enter your password" type="password" id="password" name="password" required>

                        <button type="submit">Login</button>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="error-message">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <p>@error.ErrorMessage</p>
                                }
                            </div>
                        }

                    </form>
                </div>

                <div id="signup-content" class="form">
                    <form asp-action="SignUp" method="post">

                        <input placeholder="Enter your full name" type="text" id="name" name="name" required>
                        <input placeholder="Enter your email" type="email" id="email" name="email" required>
                        <input placeholder="Enter your street number" type="number" id="streetNumber" name="streetNumber" min="1" max="999" required >
                        <input placeholder="Enter your street" type="text" id="street" name="street" required>
                        <input placeholder="Enter your city" type="text" id="city" name="city" required>
                        <select id="state" name="state" required>
                            <option value="" diabled selected style="display: none;">Enter your state</option>
                            <option value="NSW">NSW</option>
                            <option value="QLD">QLD</option>
                            <option value="VIC">VIC</option>
                            <option value="ACT">ACT</option>
                            <option value="TAS">TAS</option>
                            <option value="NT">NT</option>
                            <option value="SA">SA</option>
                            <option value="WA">WA</option>
                        </select>
                        <input placeholder="Enter your phone number" type="tel" id="phoneNumber" name="phoneNumber" required>
                        <input placeholder="Enter a password" type="text" id="password" name="password" required>

                        <button type="submit">Sign up</button>

                    </form>
                </div>

            </div>

        </div>

    </div>
</body>

</html>
