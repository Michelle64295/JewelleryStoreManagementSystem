@model JewelleryStoreManagementSystem.Data.Models.Order

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
</head>

<body>
    <ul style="background-color: #9b7d61;">
        <li><a href="@Url.Action("Home", "Home")"><img src="~/images/Logo.png" alt="Logo" class="logo"></a></li>
        <li style="float:right"><a href="@Url.Action("Order", "Order")">Shopping Cart</a></li>
        <li style="float:right"><a href="@Url.Action("Products", "Products")">Products</a></li>
        <li style="float:right"><a href="@Url.Action("LogOut", "Login")">Logout</a></li>
    </ul>

    <h2>Shopping Cart</h2>

    @if (Model.OrderItems != null && Model.OrderItems.Any())
    {
        @foreach (var item in Model.OrderItems)
        {
            <div class="main-container">
                <img src="@Url.Content(item.Product.ImagePath)" alt="@item.Product.Name" class="product-image">

                <form asp-controller="Order" asp-action="Remove" method="post">
                    <input type="hidden" name="name" value="@item.Product.Name" />
                    <div class="product-details">
                        <h4>@item.Product.Name</h4>
                        <h5>Total Price: @string.Format("{0:C}", item.Product.Price * item.Quantity)</h5>
                        <h6>Quantity: @item.Quantity</h6>
                        <button type="submit">Remove</button>
                    
                    </div>
                </form>

            </div>
        }

        <form asp-controller="Order" asp-action="CompleteOrder" method="post" class="complete-order-form">
            <button type="submit">Complete Order</button>
        </form>
    }
    else
    {
        <p>Your cart is empty.</p>
    }

</body>

</html>
