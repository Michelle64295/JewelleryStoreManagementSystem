@model JewelleryStoreManagementSystem.Data.Models.Order

<h2>Shopping Cart</h2>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
</head>

<body>

@if (Model.OrderItems != null)
{
    @foreach (var item in Model.OrderItems)
    {
        <div class="main-container">
            <img src="@Url.Content(item.Product.ImagePath)" alt="@item.Product.Name" class="product-image">

            <div class="product-details-first-row">
                <p>@item.Product.Name</p>
                <p>@item.Product.Price</p>
            </div>

            <div class="product-details-second-row">
                <p>@item.Quantity</p>
            </div>

        </div>
    }
    @* <p>Total: @(Model.OrderItems.Sum(s => decimal.Parse(s.Product.Price) * s.Quantity))</p> *@

    <form asp-action="CompleteOrder" method="post">
        <button type="submit">Complete Order</button>
    </form>
}
else
{
    <p>Your cart is empty.</p>
}

</body>

</html>
