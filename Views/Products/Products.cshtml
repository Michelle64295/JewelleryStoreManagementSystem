@model IEnumerable<JewelleryStoreManagementSystem.Data.Models.Product>

@{
    ViewData["Title"] = "Products";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
    <style>
        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            padding: 16px;
            margin-top: 20px;
        }

        .product-item {
            width: 300px;
            text-align: left;
            font-family: "Nunito Sans", sans-serif;
            font-size: 18px;
        }

        .product-image {
            width: 100%;
            height: auto;
            margin-bottom: 10px;
        }

        .product-details p {
            font-size: 16px;
            margin-bottom: 3px;
        }

        .product-details {
            padding-bottom: 10px;
        }
    </style>
</head>

<body>

    <ul style="background-color: #9b7d61;">
        <li><a href="@Url.Action("Home", "Home")"><img src="~/images/Logo.png" alt="Logo" class="logo"></a></li>
        <li style="float:right"><a href="@Url.Action("Order", "Home")">Shopping Cart</a></li>
        <li style="float:right"><a href="@Url.Action("Products", "Home")">Products</a></li>
    </ul>

    <div class="product-grid">
        @foreach (var product in Model)
        {
            <div class="product-item">
                <a style="text-decoration: none" href="@Url.Action("ProductDetails", "Home", new { id = product.ProductId })">
                    <img src="@Url.Content(product.ImagePath)" alt="@product.Name" class="product-image">
                    <div class="product-details">
                        <p style="color: #9b7d61">@product.Name</p>
                        <p style="color: #9b7d61">@product.Price</p>
                    </div>
                </a>
            </div>
        }
    </div>

</body>
</html>